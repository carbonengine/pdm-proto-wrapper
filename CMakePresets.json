{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "common",
      "toolchainFile": "${sourceDir}/vendor/github.com/microsoft/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "binaryDir": "${sourceDir}/.cmake-build-${presetName}",
      "cacheVariables": {
        "VCPKG_USE_HOST_TOOLS": "ON",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      },
      "environment": {
        "PATH_TO_VCPKG_ROOT": "${sourceDir}/vendor/github.com/microsoft/vcpkg"
      },
      "hidden": true
    },
    {
      "name": "windows",
      "inherits": "common",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "hidden": true
    },
    {
      "name": "arm64-osx",
      "inherits": "common",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/vendor/github.com/carbonengine/vcpkg-registry/toolchains/arm64-osx-carbon.cmake"
      },
      "hidden": true
    },
    {
      "name": "x64-osx",
      "inherits": "common",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/vendor/github.com/carbonengine/vcpkg-registry/toolchains/x64-osx-carbon.cmake"
      },
      "hidden": true
    },
    {
      "name": "x64-windows-internal",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Internal",
        "VCPKG_TARGET_TRIPLET": "x64-windows-145-static-internal",
        "VCPKG_HOST_TRIPLET": "x64-windows-145-static-internal",
        "COMBINE_STATIC_LIBS": "ON",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/vendor/github.com/carbonengine/vcpkg-registry/toolchains/x64-windows-145-carbon.cmake"
      }
    },
    {
      "name": "x64-windows-static-release",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-145-static-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-145-static-release",
        "COMBINE_STATIC_LIBS": "ON",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/vendor/github.com/carbonengine/vcpkg-registry/toolchains/x64-windows-145-carbon.cmake"
      }
    },
    {
      "name": "x64-windows-static-debug",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows-145-static-debug",
        "VCPKG_HOST_TRIPLET": "x64-windows-145-static-debug",
        "COMBINE_STATIC_LIBS": "ON",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/vendor/github.com/carbonengine/vcpkg-registry/toolchains/x64-windows-145-carbon.cmake"
      }
    },
    {
      "name": "x64-windows-static-trinitydev",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "TrinityDev",
        "VCPKG_TARGET_TRIPLET": "x64-windows-145-static-trinitydev",
        "VCPKG_HOST_TRIPLET": "x64-windows-145-static-trinitydev",
        "COMBINE_STATIC_LIBS": "ON",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/vendor/github.com/carbonengine/vcpkg-registry/toolchains/x64-windows-145-carbon.cmake"
      }
    },
    {
      "name": "x64-windows-static-internal-mt",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Internal",
        "VCPKG_TARGET_TRIPLET": "x64-windows-145-static-internal-mt",
        "VCPKG_HOST_TRIPLET": "x64-windows-145-static-internal-mt",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    },
    {
      "name": "x64-windows-static-release-mt",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-145-static-release-mt",
        "VCPKG_HOST_TRIPLET": "x64-windows-145-static-release-mt",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    },
    {
      "name": "x64-windows-static-debug-mt",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows-145-static-debug-mt",
        "VCPKG_HOST_TRIPLET": "x64-windows-145-static-debug-mt",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    },
    {
      "name": "x64-windows-static-trinitydev-mt",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "TrinityDev",
        "VCPKG_TARGET_TRIPLET": "x64-windows-145-static-trinitydev-mt",
        "VCPKG_HOST_TRIPLET": "x64-windows-145-static-trinitydev-mt",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    },

    {
      "name": "arm64-osx-static-internal",
      "inherits": "arm64-osx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Internal",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-static-internal",
        "VCPKG_HOST_TRIPLET": "arm64-osx-static-internal"
      }
    },
    {
      "name": "arm64-osx-static-release",
      "inherits": "arm64-osx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-static-release",
        "VCPKG_HOST_TRIPLET": "arm64-osx-static-release"
      }
    },
    {
      "name": "arm64-osx-static-debug",
      "inherits": "arm64-osx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-static-debug",
        "VCPKG_HOST_TRIPLET": "arm64-osx-static-debug"
      }
    },
    {
      "name": "arm64-osx-static-trinitydev",
      "inherits": "arm64-osx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "TrinityDev",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-static-trinitydev",
        "VCPKG_HOST_TRIPLET": "arm64-osx-static-trinitydev"
      }
    },
    {
      "name": "x64-osx-static-internal",
      "inherits": "x64-osx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Internal",
        "VCPKG_TARGET_TRIPLET": "x64-osx-static-internal",
        "VCPKG_HOST_TRIPLET": "x64-osx-static-internal"
      }
    },
    {
      "name": "x64-osx-static-release",
      "inherits": "x64-osx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-osx-static-release",
        "VCPKG_HOST_TRIPLET": "x64-osx-static-release"
      }
    },
    {
      "name": "x64-osx-static-debug",
      "inherits": "x64-osx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-osx-static-debug",
        "VCPKG_HOST_TRIPLET": "x64-osx-static-debug"
      }
    },
    {
      "name": "x64-osx-static-trinitydev",
      "inherits": "x64-osx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "TrinityDev",
        "VCPKG_TARGET_TRIPLET": "x64-osx-static-trinitydev",
        "VCPKG_HOST_TRIPLET": "x64-osx-static-trinitydev"
      }
    }
  ]
}
